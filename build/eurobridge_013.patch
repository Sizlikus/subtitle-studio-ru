+    private void saveSelectedProfile() {
+        if (selectedIndex < 0 || selectedIndex >= servers.size()) return;
+        VpnServer server = servers.get(selectedIndex);
+        saveProfileButton.setEnabled(false);
+        status.setText("Готовлю .ovpn для сохранения: " + server.ip + "…");
+
+        io.execute(() -> {
+            try {
+                File profile = createProfile(server);
+                long profileBytes = profile.length();
+                main.post(() -> {
+                    showProfileReady(profile, server, profileBytes);
+                    pendingSaveProfile = profile;
+                    pendingSaveServer = server;
+                    Intent intent = new Intent(Intent.ACTION_CREATE_DOCUMENT);
+                    intent.addCategory(Intent.CATEGORY_OPENABLE);
+                    intent.setType("application/x-openvpn-profile");
+                    intent.putExtra(Intent.EXTRA_TITLE, profile.getName());
+                    try {
+                        startActivityForResult(intent, REQUEST_SAVE_PROFILE);
+                    } catch (ActivityNotFoundException e) {
+                        status.setText("На телефоне нет системного окна сохранения файлов.");
+                        saveProfileButton.setEnabled(true);
+                    }
+                });
+            } catch (Exception e) {
+                main.post(() -> {
+                    profileInfo.setText("Профиль .ovpn: ошибка — " + safeMessage(e));
+                    status.setText("Ошибка профиля: " + safeMessage(e));
+                    saveProfileButton.setEnabled(true);
+                });
+            }
+        });
+    }
+
+    private void showProfileReady(File profile, VpnServer server, long bytes) {
+        double kb = bytes / 1024.0;
+        String size = String.format(Locale.US, "%.1f КБ", kb);
+        profileInfo.setText("Профиль: " + profile.getName() + " • " + size + " • меньше 256 КБ ✓");
+        status.setText("Готов профиль " + size + " для " + server.countryLong + " / " + server.ip);
+        saveProfileButton.setEnabled(true);
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode != REQUEST_SAVE_PROFILE) return;
+        File profile = pendingSaveProfile;
+        VpnServer server = pendingSaveServer;
+        pendingSaveProfile = null;
+        pendingSaveServer = null;
+        if (resultCode != RESULT_OK || data == null || data.getData() == null) {
+            status.setText("Сохранение .ovpn отменено.");
+            saveProfileButton.setEnabled(selectedIndex >= 0 && selectedIndex < servers.size());
+            return;
+        }
+        Uri target = data.getData();
+        if (profile == null || !profile.exists()) {
+            status.setText("Временный .ovpn уже недоступен. Нажмите «СОХРАНИТЬ .OVPN» ещё раз.");
+            saveProfileButton.setEnabled(true);
+            return;
+        }
+        io.execute(() -> {
+            try (InputStream in = new FileInputStream(profile);
+                 OutputStream out = getContentResolver().openOutputStream(target, "w")) {
+                if (out == null) throw new IllegalStateException("Не удалось открыть выбранный файл для записи");
+                byte[] buf = new byte[8192];
+                int n;
+                long total = 0;
+                while ((n = in.read(buf)) != -1) {
+                    out.write(buf, 0, n);
+                    total += n;
+                }
+                final long savedBytes = total;
+                main.post(() -> {
+                    double kb = savedBytes / 1024.0;
+                    String size = String.format(Locale.US, "%.1f КБ", kb);
+                    profileInfo.setText("Сохранён .ovpn: " + profile.getName() + " • " + size + " • меньше 256 КБ ✓");
+                    status.setText(".ovpn сохранён. В OpenVPN Connect нажмите Upload File и выберите именно этот файл, не APK.");
+                    saveProfileButton.setEnabled(true);
+                });
+            } catch (Exception e) {
+                main.post(() -> {
+                    status.setText("Не удалось сохранить .ovpn: " + safeMessage(e));
+                    saveProfileButton.setEnabled(true);
+                });
+            }
+        });
+    }
